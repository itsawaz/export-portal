# Copy to backend/.env and edit. Every setting in app/config.py can be set here with the APP_ prefix.
APP_DATABASE_URL=sqlite:///./export_portal.db
# APP_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/export_portal
APP_SECRET_KEY=replace-with-a-long-random-string
APP_CORS_ORIGINS=http://localhost:5173
APP_REQUIRE_BUYER_APPROVAL=false

# --- Company / legal ---
APP_COMPANY_NAME=Your Company Exports
APP_COMPANY_TAGLINE=Compostable Bagasse Tableware — Manufacturer & Exporter
APP_COMPANY_ESTABLISHED=2025
APP_COMPANY_ADDRESS=Plot 00, Industrial Area, Your City, State, India - 000000
APP_COMPANY_CITY=Your City, India
APP_COMPANY_EMAIL=sales@yourcompany.com
APP_COMPANY_PHONE=+91 00000 00000
APP_COMPANY_GSTIN=00AAAAA0000A0Z0
APP_COMPANY_IEC=0000000000
APP_COMPANY_BANK_NAME=Your Bank Ltd.
APP_COMPANY_BANK_ACCOUNT=000000000000
APP_COMPANY_BANK_SWIFT=XXXXINBBXXX
APP_COMPANY_BANK_IFSC=XXXX0000000
APP_COMPANY_BANK_BRANCH=Main Branch, Your City
APP_DEFAULT_PORT_OF_LOADING=Nhava Sheva (INNSA)
APP_DEFAULT_PAYMENT_TERMS=30% advance by T/T, 70% against copy of B/L

# --- Portfolio / branding (controls all public-facing copy, no code changes needed) ---
APP_VENDOR_SLUG=your-company
APP_HERO_HEADLINE=Compostable tableware, crafted for the world's best tables.
APP_HERO_SUBTEXT=We manufacture plates, bowls, clamshells, containers and cutlery from sugarcane bagasse — plant-based, plastic-free, and built to last through the busiest service.
APP_ABOUT_TEXT=Founded in {established}, we set out to prove that sustainable packaging doesn't mean compromising on performance.
APP_PRODUCT_NOUN=product
APP_INQUIRY_LABEL=Request a Sample
APP_SPECIALTY_TAGS=Compostable,Food-safe,Export-ready,Private label
# JSON arrays — keep on one line or use single quotes
# APP_MARKETS_JSON=[["AE","United Arab Emirates","Dubai & GCC"],["US","United States","Food service"]]
# APP_WHY_US_JSON=[["Title","Body text"],["Title 2","Body 2"]]
# APP_PROCESS_JSON=[["Step 1","Description"],["Step 2","Description"]]
# APP_STATS_JSON=[["Label","Value"],["Label 2","Value 2"]]

# --- Optional SMTP — leave blank and e-mails are only written to the server log ---
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=
