{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: npm run dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": { "activeBegins": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "Frontend: build for production",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
